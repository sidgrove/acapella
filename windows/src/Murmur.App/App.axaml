<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Murmur.App.App"
             RequestedThemeVariant="Default">
  <!-- Default, not a fixed variant: the app follows the system, which is what picks
       between the silver face and the black face. -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <!-- Secondary interface. The main window is the app; this is for status and reaching
       Murmur while working in something else. The icon is swapped for tray-rec.ico while
       recording, from App.SetTrayRecording. -->
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/tray.ico" ToolTipText="Acapella: hold the push-to-talk key to dictate" Clicked="OnTrayShow">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Show Acapella" Click="OnTrayShow" />
            <NativeMenuItem Header="Copy last transcript" Click="OnTrayCopyLast" />
            <NativeMenuItem Header="Type last transcript again" Click="OnTrayRetypeLast" />
            <NativeMenuItem Header="Settings…" Click="OnTraySettings" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Quit Acapella" Click="OnTrayQuit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
